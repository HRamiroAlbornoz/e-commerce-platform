rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /products/{productId} {
      allow read: if true;

      match /reviews/{reviewId} {
        function hasValidReviewFields() {
          return request.resource.data.rating is int
            && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
            && request.resource.data.comment is string
            && request.resource.data.comment.size() > 0 && request.resource.data.comment.size() <= 500
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 120;
        }

        allow read: if true;

        allow create: if request.auth.uid == reviewId
          && request.resource.data.userId == reviewId
          && hasValidReviewFields()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if request.auth.uid == reviewId
          && request.resource.data.userId == resource.data.userId
          && hasValidReviewFields()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if request.auth.uid == reviewId;
      }
    }

    match /users/{uid} {
      allow read: if request.auth.uid == uid;
      allow create: if request.auth.uid == uid && request.resource.data.role == 'customer';
      allow update: if request.auth.uid == uid && request.resource.data.role == resource.data.role;
    }

    match /carts/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    match /orders/{orderId} {
      allow read: if request.auth.uid == resource.data.userId;
    }
  }
}
