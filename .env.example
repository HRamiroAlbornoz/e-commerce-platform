# CLACK · plantilla de variables de entorno
#
# Copiar a .env para desarrollo local. El archivo .env esta en .gitignore y
# nunca se commitea. Este archivo si se commitea, con los nombres y SIN valores.
#
# En produccion estas variables se cargan en el dashboard de Vercel, no en un
# archivo. Cada cambio requiere un redeploy para tomar efecto.


# ----------------------------------------------------------------------------
# FRONTEND · prefijo VITE_
# ----------------------------------------------------------------------------
# ATENCION: todo lo que lleva el prefijo VITE_ queda DENTRO DEL BUNDLE y es
# visible para cualquiera que abra las herramientas de desarrollador. Nunca
# poner un secreto aca.
#
# La configuracion de Firebase es publica por diseno: identifica al proyecto,
# no autoriza nada. Lo que protege los datos son las security rules, no el
# secreto de estos valores.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# En true, el cliente se conecta al Emulator Suite local en vez del proyecto
# real. Solo para desarrollo; en produccion queda en false o sin definir.
VITE_USE_FIREBASE_EMULATORS=true


# ----------------------------------------------------------------------------
# SERVERLESS · sin prefijo
# ----------------------------------------------------------------------------
# Estas variables SOLO las ven las Vercel Functions en api/. Al no llevar el
# prefijo VITE_, Vite no las puede incluir en el bundle ni por accidente: es
# el mecanismo que mantiene las credenciales de AWS fuera del navegador.

# --- AWS S3 ---
# Se usa el prefijo S3_ y no AWS_ a proposito. No pudimos confirmar si Vercel
# reserva los nombres AWS_* para el runtime de sus funciones, y un nombre
# reservado falla en silencio. Con un prefijo propio la pregunta no existe.
#
# Consecuencia: hay que pasarle las credenciales explicitamente al S3Client,
# porque el SDK de AWS solo lee automaticamente los nombres AWS_*.
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Firebase Admin SDK ---
# Se usan los tres campos sueltos en vez del JSON completo del service account,
# para no tener que pegar un objeto entero en el dashboard de Vercel.
#
# CUIDADO con la clave privada: tiene saltos de linea reales. Al pegarla en
# Vercel hay que guardarla con los \n escapados y normalizarla al inicializar
# con .replace(/\\n/g, '\n'). Pegarla tal cual es el error mas comun de este
# deploy y produce un error de formato de clave que no dice nada util.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
